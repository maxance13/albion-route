{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/health", "destination": "https://albion-route-api.onrender.com/health" },
    { "source": "/api/:path*", "destination": "https://albion-route-api.onrender.com/api/:path*" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
